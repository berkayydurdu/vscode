{
  "name": "nighthawk-agent",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "enabledApiProposals": [
    "contribSourceControlInputBoxMenu",
    "terminalQuickFixProvider",
    "editorInsets",
    "inlineCompletionsAdditions"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrusted%",
      "restrictedConfigurations": [
        "nighthawk.agent.shell",
        "nighthawk.agent.hooks",
        "nighthawk.agent.mcpServers",
        "nighthawk.agent.permissions.allow"
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "contributes": {
    "configuration": [
      {
        "title": "%config.ai.title%",
        "properties": {
          "nighthawk.ai.endpoints": {
            "type": "array",
            "scope": "application",
            "default": [],
            "markdownDescription": "%config.ai.endpoints%",
            "items": {
              "type": "object",
              "required": [
                "name",
                "provider",
                "baseUrl",
                "models"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "%config.ai.endpoints.name%"
                },
                "provider": {
                  "type": "string",
                  "enum": [
                    "anthropic",
                    "openai"
                  ],
                  "enumDescriptions": [
                    "%config.ai.endpoints.provider.anthropic%",
                    "%config.ai.endpoints.provider.openai%"
                  ]
                },
                "baseUrl": {
                  "type": "string",
                  "description": "%config.ai.endpoints.baseUrl%"
                },
                "models": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "%config.ai.endpoints.models%"
                },
                "contextWindow": {
                  "type": "number",
                  "description": "%config.ai.endpoints.contextWindow%"
                },
                "maxOutputTokens": {
                  "type": "number",
                  "description": "%config.ai.endpoints.maxOutputTokens%"
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "%config.ai.endpoints.headers%"
                }
              }
            }
          },
          "nighthawk.ai.model": {
            "type": "string",
            "scope": "application",
            "default": "",
            "markdownDescription": "%config.ai.model%"
          },
          "nighthawk.ai.monthlyLimit": {
            "type": "number",
            "scope": "application",
            "default": 0,
            "minimum": 0,
            "markdownDescription": "%config.ai.monthlyLimit%"
          },
          "nighthawk.ai.prices": {
            "type": "object",
            "scope": "application",
            "default": {},
            "markdownDescription": "%config.ai.prices%",
            "additionalProperties": {
              "type": "object",
              "required": [
                "input",
                "output"
              ],
              "properties": {
                "input": {
                  "type": "number",
                  "minimum": 0,
                  "description": "%config.ai.prices.input%"
                },
                "output": {
                  "type": "number",
                  "minimum": 0,
                  "description": "%config.ai.prices.output%"
                },
                "cacheRead": {
                  "type": "number",
                  "minimum": 0,
                  "description": "%config.ai.prices.cacheRead%"
                },
                "cacheWrite": {
                  "type": "number",
                  "minimum": 0,
                  "description": "%config.ai.prices.cacheWrite%"
                }
              }
            }
          }
        }
      },
      {
        "title": "%config.agent.title%",
        "properties": {
          "nighthawk.agent.background.maxParallel": {
            "type": "number",
            "scope": "application",
            "default": 3,
            "minimum": 1,
            "maximum": 10,
            "description": "%config.agent.background.maxParallel%"
          },
          "nighthawk.agent.background.permissionMode": {
            "type": "string",
            "scope": "application",
            "enum": [
              "default",
              "acceptEdits",
              "bypassPermissions"
            ],
            "enumDescriptions": [
              "%config.agent.permissionMode.default%",
              "%config.agent.permissionMode.acceptEdits%",
              "%config.agent.permissionMode.bypassPermissions%"
            ],
            "default": "acceptEdits",
            "description": "%config.agent.background.permissionMode%"
          },
          "nighthawk.agent.permissionMode": {
            "type": "string",
            "scope": "application",
            "enum": [
              "default",
              "acceptEdits",
              "plan",
              "bypassPermissions"
            ],
            "enumDescriptions": [
              "%config.agent.permissionMode.default%",
              "%config.agent.permissionMode.acceptEdits%",
              "%config.agent.permissionMode.plan%",
              "%config.agent.permissionMode.bypassPermissions%"
            ],
            "default": "default",
            "description": "%config.agent.permissionMode%"
          },
          "nighthawk.agent.permissions.allow": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "scope": "application",
            "default": [],
            "markdownDescription": "%config.agent.permissions.allow%"
          },
          "nighthawk.agent.permissions.deny": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.agent.permissions.deny%"
          },
          "nighthawk.agent.effort": {
            "type": "string",
            "enum": [
              "",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "high",
            "markdownDescription": "%config.agent.effort%"
          },
          "nighthawk.agent.thinking": {
            "type": "boolean",
            "default": true,
            "description": "%config.agent.thinking%"
          },
          "nighthawk.agent.autoCompact": {
            "type": "boolean",
            "default": true,
            "description": "%config.agent.autoCompact%"
          },
          "nighthawk.agent.checkpoints": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.agent.checkpoints%"
          },
          "nighthawk.agent.maxSteps": {
            "type": "number",
            "default": 200,
            "minimum": 1,
            "description": "%config.agent.maxSteps%"
          },
          "nighthawk.agent.shell": {
            "type": "string",
            "scope": "machine",
            "default": "",
            "markdownDescription": "%config.agent.shell%"
          },
          "nighthawk.agent.externalAgents": {
            "type": "array",
            "scope": "application",
            "default": [],
            "markdownDescription": "%config.agent.externalAgents%",
            "items": {
              "type": "object",
              "required": [
                "name",
                "command"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "%config.agent.externalAgents.name%"
                },
                "command": {
                  "type": "string",
                  "description": "%config.agent.externalAgents.command%"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "%config.agent.externalAgents.args%"
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "%config.agent.externalAgents.env%"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "nighthawk.agent.memories": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "markdownDescription": "%config.agent.memories%"
          },
          "nighthawk.agent.systemPrompt": {
            "type": "string",
            "default": "",
            "editPresentation": "multilineText",
            "markdownDescription": "%config.agent.systemPrompt%"
          },
          "nighthawk.agent.mcpServers": {
            "type": "object",
            "scope": "application",
            "default": {},
            "markdownDescription": "%config.agent.mcpServers%"
          },
          "nighthawk.agent.hooks": {
            "type": "object",
            "scope": "application",
            "default": {},
            "markdownDescription": "%config.agent.hooks%"
          }
        }
      },
      {
        "title": "%config.inlineEdit.title%",
        "properties": {
          "nighthawk.inlineEdit.model": {
            "type": "string",
            "scope": "application",
            "default": "",
            "markdownDescription": "%config.inlineEdit.model%"
          }
        }
      },
      {
        "title": "%config.autocomplete.title%",
        "properties": {
          "nighthawk.autocomplete.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.autocomplete.enabled%"
          },
          "nighthawk.autocomplete.model": {
            "type": "string",
            "scope": "application",
            "default": "",
            "markdownDescription": "%config.autocomplete.model%"
          },
          "nighthawk.autocomplete.delay": {
            "type": "number",
            "default": 300,
            "minimum": 0,
            "maximum": 5000,
            "markdownDescription": "%config.autocomplete.delay%"
          },
          "nighthawk.autocomplete.nextEdits": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.autocomplete.nextEdits%"
          },
          "nighthawk.autocomplete.disabledLanguages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "plaintext",
              "markdown",
              "scminput"
            ],
            "markdownDescription": "%config.autocomplete.disabledLanguages%"
          }
        }
      },
      {
        "title": "%config.index.title%",
        "properties": {
          "nighthawk.index.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.index.enabled%"
          },
          "nighthawk.index.embeddingModel": {
            "type": "string",
            "scope": "application",
            "default": "",
            "markdownDescription": "%config.index.embeddingModel%"
          },
          "nighthawk.index.exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.index.exclude%"
          },
          "nighthawk.index.maxFiles": {
            "type": "number",
            "default": 50000,
            "minimum": 1,
            "markdownDescription": "%config.index.maxFiles%"
          }
        }
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "nighthawk-agent",
          "icon": "$(sparkle)",
          "title": "%container.title%"
        }
      ]
    },
    "views": {
      "nighthawk-agent": [
        {
          "type": "webview",
          "id": "nighthawk.agent.chat",
          "name": "%view.chat%",
          "icon": "$(sparkle)"
        },
        {
          "id": "nighthawk.agent.background",
          "name": "%view.background%",
          "icon": "$(layers)",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nighthawk.agent.background",
        "contents": "%view.background.welcome%"
      }
    ],
    "commands": [
      {
        "command": "nighthawk.agent.background.start",
        "title": "%command.background.start%",
        "category": "%category.agent%",
        "icon": "$(add)"
      },
      {
        "command": "nighthawk.agent.background.open",
        "title": "%command.background.open%",
        "category": "%category.agent%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "nighthawk.agent.background.resume",
        "title": "%command.background.resume%",
        "category": "%category.agent%",
        "icon": "$(debug-continue)"
      },
      {
        "command": "nighthawk.agent.background.review",
        "title": "%command.background.review%",
        "category": "%category.agent%",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "nighthawk.agent.background.merge",
        "title": "%command.background.merge%",
        "category": "%category.agent%",
        "icon": "$(git-merge)"
      },
      {
        "command": "nighthawk.agent.background.openFolder",
        "title": "%command.background.openFolder%",
        "category": "%category.agent%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "nighthawk.agent.background.stop",
        "title": "%command.background.stop%",
        "category": "%category.agent%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nighthawk.agent.background.discard",
        "title": "%command.background.discard%",
        "category": "%category.agent%",
        "icon": "$(trash)"
      },
      {
        "command": "nighthawk.agent.open",
        "title": "%command.open%",
        "category": "%category.agent%",
        "icon": "$(sparkle)"
      },
      {
        "command": "nighthawk.agent.openInEditor",
        "title": "%command.openInEditor%",
        "category": "%category.agent%",
        "icon": "$(link-external)"
      },
      {
        "command": "nighthawk.agent.newSession",
        "title": "%command.newSession%",
        "category": "%category.agent%",
        "icon": "$(add)"
      },
      {
        "command": "nighthawk.agent.history",
        "title": "%command.history%",
        "category": "%category.agent%",
        "icon": "$(history)"
      },
      {
        "command": "nighthawk.agent.restoreCheckpoint",
        "title": "%command.restoreCheckpoint%",
        "category": "%category.agent%",
        "icon": "$(discard)"
      },
      {
        "command": "nighthawk.agent.undoRestore",
        "title": "%command.undoRestore%",
        "category": "%category.agent%"
      },
      {
        "command": "nighthawk.agent.addSelection",
        "title": "%command.addSelection%",
        "category": "%category.agent%"
      },
      {
        "command": "nighthawk.agent.fixProblems",
        "title": "%command.fixProblems%",
        "category": "%category.agent%"
      },
      {
        "command": "nighthawk.agent.setPermissionMode",
        "title": "%command.setPermissionMode%",
        "category": "%category.agent%"
      },
      {
        "command": "nighthawk.agent.restartMcp",
        "title": "%command.restartMcp%",
        "category": "%category.agent%"
      },
      {
        "command": "nighthawk.ai.addEndpoint",
        "title": "%command.addEndpoint%",
        "category": "%category.ai%"
      },
      {
        "command": "nighthawk.ai.selectModel",
        "title": "%command.selectModel%",
        "category": "%category.ai%"
      },
      {
        "command": "nighthawk.ai.setApiKey",
        "title": "%command.setApiKey%",
        "category": "%category.ai%"
      },
      {
        "command": "nighthawk.ai.removeEndpoint",
        "title": "%command.removeEndpoint%",
        "category": "%category.ai%"
      },
      {
        "command": "nighthawk.ai.manageEndpoints",
        "title": "%command.manageEndpoints%",
        "category": "%category.ai%",
