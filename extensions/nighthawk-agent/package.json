      },
      {
        "command": "nighthawk.multibuffer.openSource",
        "title": "%command.multibuffer.openSource%",
        "category": "%category.multibuffer%"
      },
      {
        "command": "nighthawk.multibuffer.reload",
        "title": "%command.multibuffer.reload%",
        "category": "%category.multibuffer%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nighthawk.multibuffer.openSource",
          "when": "resourceScheme == nighthawk-multibuffer"
        },
        {
          "command": "nighthawk.multibuffer.reload",
          "when": "resourceScheme == nighthawk-multibuffer"
        },
        {
          "command": "nighthawk.spec.approve",
          "when": "false"
        },
        {
          "command": "nighthawk.spec.revise",
          "when": "false"
        },
        {
          "command": "nighthawk.spec.runTask",
          "when": "false"
        },
        {
          "command": "nighthawk.spec.runAll",
          "when": "false"
        },
        {
          "command": "nighthawk.agent.background.open",
          "when": "false"
        },
        {
          "command": "nighthawk.agent.background.resume",
          "when": "false"
        },
        {
          "command": "nighthawk.agent.background.review",
          "when": "false"
        },
        {
          "command": "nighthawk.agent.background.merge",
          "when": "false"
        },
        {
          "command": "nighthawk.agent.background.openFolder",
          "when": "false"
        },
        {
          "command": "nighthawk.agent.background.stop",
          "when": "false"
        },
        {
          "command": "nighthawk.agent.background.discard",
          "when": "false"
        },
        {
          "command": "nighthawk.inlineEdit.accept",
          "when": "nighthawk.inlineEdit.reviewing"
        },
        {
          "command": "nighthawk.inlineEdit.reject",
          "when": "nighthawk.inlineEdit.reviewing"
        },
        {
          "command": "nighthawk.inlineEdit.acceptChange",
          "when": "false"
        },
        {
          "command": "nighthawk.inlineEdit.rejectChange",
          "when": "false"
        },
        {
          "command": "nighthawk.inlineEdit.cancel",
          "when": "nighthawk.inlineEdit.generating"
        },
        {
          "command": "nighthawk.inlineEdit.start",
          "when": "editorIsOpen && !editorReadonly"
        }
      ],
      "view/title": [
        {
          "command": "nighthawk.terminal.askForCommand",
          "when": "view == terminal",
          "group": "navigation@0"
        },
        {
          "command": "nighthawk.agent.background.start",
          "when": "view == nighthawk.agent.background",
          "group": "navigation"
        },
        {
          "command": "nighthawk.agent.newSession",
          "when": "view == nighthawk.agent.chat",
          "group": "navigation@1"
        },
        {
          "command": "nighthawk.agent.history",
          "when": "view == nighthawk.agent.chat",
          "group": "navigation@2"
        },
        {
          "command": "nighthawk.agent.restoreCheckpoint",
          "when": "view == nighthawk.agent.chat",
          "group": "checkpoints@1"
        },
        {
          "command": "nighthawk.agent.openInEditor",
          "when": "view == nighthawk.agent.chat",
          "group": "navigation@3"
        },
        {
          "command": "nighthawk.ai.manageEndpoints",
          "when": "view == nighthawk.agent.chat",
          "group": "1_settings@1"
        },
        {
          "command": "nighthawk.agent.restartMcp",
          "when": "view == nighthawk.agent.chat",
          "group": "1_settings@2"
        }
      ],
      "view/item/context": [
        {
          "command": "nighthawk.agent.background.review",
          "when": "view == nighthawk.agent.background && viewItem =~ /^backgroundTask\\.(done|stopped|failed|waiting|running)$/",
          "group": "inline@1"
        },
        {
          "command": "nighthawk.agent.background.merge",
          "when": "view == nighthawk.agent.background && viewItem =~ /^backgroundTask\\.(done|stopped)$/",
          "group": "inline@2"
        },
        {
          "command": "nighthawk.agent.background.stop",
          "when": "view == nighthawk.agent.background && viewItem =~ /^backgroundTask\\.(running|waiting|queued)$/",
          "group": "inline@3"
        },
        {
          "command": "nighthawk.agent.background.open",
          "when": "view == nighthawk.agent.background",
          "group": "1_open@1"
        },
        {
          "command": "nighthawk.agent.background.review",
          "when": "view == nighthawk.agent.background",
          "group": "1_open@2"
        },
        {
          "command": "nighthawk.agent.background.openFolder",
          "when": "view == nighthawk.agent.background",
          "group": "1_open@3"
        },
        {
          "command": "nighthawk.agent.background.resume",
          "when": "view == nighthawk.agent.background && viewItem =~ /^backgroundTask\\.(done|stopped|failed)$/",
          "group": "2_work@1"
        },
        {
          "command": "nighthawk.agent.background.merge",
          "when": "view == nighthawk.agent.background && viewItem =~ /^backgroundTask\\.(done|stopped|failed)$/",
          "group": "2_work@2"
        },
        {
          "command": "nighthawk.agent.background.stop",
          "when": "view == nighthawk.agent.background && viewItem =~ /^backgroundTask\\.(running|waiting|queued)$/",
          "group": "2_work@3"
        },
        {
          "command": "nighthawk.agent.background.discard",
          "when": "view == nighthawk.agent.background",
          "group": "3_remove@1"
        }
      ],
      "scm/inputBox": [
        {
          "command": "nighthawk.ai.generateCommitMessage",
          "when": "scmProvider == git"
        }
      ],
      "scm/title": [
        {
          "command": "nighthawk.agent.reviewBranch",
          "when": "scmProvider == git",
          "group": "navigation@50"
        }
      ],
      "terminal/context": [
        {
          "command": "nighthawk.terminal.askForCommand",
          "group": "nighthawk@1"
        },
        {
          "command": "nighthawk.terminal.explainError",
          "when": "nighthawk.terminal.hasFailure",
          "group": "nighthawk@2"
        }
      ],
      "editor/context": [
        {
          "command": "nighthawk.multibuffer.references",
          "when": "editorHasReferenceProvider",
          "group": "navigation@99"
        },
        {
          "command": "nighthawk.inlineEdit.start",
          "when": "!editorReadonly",
          "group": "nighthawk@0"
        },
        {
          "command": "nighthawk.agent.addSelection",
          "group": "nighthawk@1"
        },
        {
          "command": "nighthawk.agent.fixProblems",
          "group": "nighthawk@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nighthawk.multibuffer.openSource",
        "key": "alt+enter",
        "when": "editorTextFocus && resourceScheme == nighthawk-multibuffer"
      },
      {
        "command": "nighthawk.agent.open",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "nighthawk.agent.addSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "nighthawk.agent.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "focusedView == nighthawk.agent.chat"
      },
      {
        "command": "nighthawk.terminal.askForCommand",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "terminalFocus"
      },
      {
        "command": "nighthawk.inlineEdit.start",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "nighthawk.inlineEdit.accept",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && nighthawk.inlineEdit.reviewing"
      },
      {
        "command": "nighthawk.inlineEdit.reject",
        "key": "ctrl+backspace",
        "mac": "cmd+backspace",
        "when": "editorTextFocus && nighthawk.inlineEdit.reviewing"
      },
      {
        "command": "nighthawk.inlineEdit.cancel",
        "key": "escape",
        "when": "editorTextFocus && nighthawk.inlineEdit.generating"
      },
      {
        "command": "editor.action.inlineSuggest.trigger",
        "key": "alt+\\",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "terminalQuickFixes": [
      {
        "id": "nighthawk.agent.explainError",
        "commandLineMatcher": ".+",
        "commandExitResult": "error",
        "outputMatcher": {
          "anchor": "bottom",
          "length": 40,
          "lineMatcher": ".+",
          "offset": 0
        },
        "kind": "explain"
      }
    ],
    "configurationDefaults": {
      "terminal.integrated.commandsToSkipShell": [
        "nighthawk.terminal.askForCommand"
      ]
    }
  },
  "scripts": {
    "compile": "npx gulp compile-extension:nighthawk-agent && npm run build-webview",
    "watch": "npm run build-webview && npx gulp watch-extension:nighthawk-agent",
    "build-webview": "node ./esbuild.webview.mts",
    "test": "node --import ./test/setup.ts --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/berkayydurdu/vscode.git"
  }
}
