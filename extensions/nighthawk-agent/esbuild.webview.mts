import path from 'path';
import { run } from '../esbuild-webview-common.mts';

const srcDir = path.join(import.meta.dirname, 'webview-src');
const outDir = path.join(import.meta.dirname, 'media');

await run({
	entryPoints: {
		'agent': path.join(srcDir, 'main.ts'),
		'usage': path.join(srcDir, 'usage.ts'),
		'inlineEdit': path.join(srcDir, 'inlineEdit.ts'),
		'preview': path.join(srcDir, 'preview.ts'),
		'codeMap': path.join(srcDir, 'codeMap.ts'),
		'previewPicker': path.join(srcDir, 'previewPicker.ts'),
	},
	srcDir,
	outdir: outDir,
}, process.argv);

// The automatic PR reviewer, copied into repositories as one readable script that runs on Node in GitHub Actions.
await run({
	entryPoints: {
		'reviewBot': path.join(import.meta.dirname, 'src', 'bot', 'reviewBot.ts'),
	},
	srcDir: path.join(import.meta.dirname, 'src'),
	outdir: outDir,
	additionalOptions: {
		minify: false,
		platform: 'node',
		target: ['node20'],
		outExtension: { '.js': '.mjs' },
		banner: { js: '// Nighthawk automatic pull request review. Generated by "AI: Set Up Automatic PR Reviews"; see https://github.com/berkayydurdu/vscode.' },
	},
}, process.argv);
